rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives (optimized to stay well below Firestore's 1,000-expression cap)
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedUser()
        && request.auth.token.email == 'wachirapornkun@gmail.com';
    }

    function isStr(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    function isNonEmptyStr(val, maxLen) {
      return val is string && val.size() >= 1 && val.size() <= maxLen;
    }

    function isBoundedStringList(arr, maxItems, maxItemLen) {
      return arr is list
        && arr.size() <= maxItems
        && (arr.size() == 0 || (arr[0] is string && arr[0].size() <= maxItemLen));
    }

    function isValidFormData(fd) {
      return fd is map
        && fd.keys().hasAll([
          'history', 'physicalExam', 'investigation', 'laboratory',
          'premedication', 'consult', 'problemList', 'anestheticPlan',
          'preparationOrders', 'postAnesthesia'
        ])
        && fd.keys().hasOnly([
          'history', 'physicalExam', 'investigation', 'laboratory',
          'premedication', 'consult', 'consultTypes', 'problemList', 'anestheticPlan',
          'preparationOrders', 'postAnesthesia', 'postOpComplication',
          'surgeryPostponement', 'preOpNotVisited'
        ])
        && fd.history is map && fd.history.keys().size() <= 65
        && fd.physicalExam is map && fd.physicalExam.keys().size() <= 40
        && fd.investigation is map && fd.investigation.keys().size() <= 10
        && fd.laboratory is map && fd.laboratory.keys().size() <= 75
        && fd.premedication is map && fd.premedication.keys().size() <= 8
        && isStr(fd.consult, 1500)
        && (!('consultTypes' in fd) || (
          fd.consultTypes is list
          && fd.consultTypes.size() <= 7
          && fd.consultTypes.hasOnly(['none', 'med', 'cardio', 'neuro', 'chest', 'nephro', 'other'])
        ))
        && isBoundedStringList(fd.problemList, 12, 250)
        && fd.anestheticPlan is map && fd.anestheticPlan.keys().size() <= 12
        && isBoundedStringList(fd.preparationOrders, 12, 250)
        && fd.postAnesthesia is map && fd.postAnesthesia.keys().size() <= 20
        && (!('postOpComplication' in fd) || (
          fd.postOpComplication is map && fd.postOpComplication.keys().size() <= 30
        ))
        && (!('surgeryPostponement' in fd) || (
          fd.surgeryPostponement is map && fd.surgeryPostponement.keys().size() <= 12
        ))
        && (!('preOpNotVisited' in fd) || (
          fd.preOpNotVisited is map && fd.preOpNotVisited.keys().size() <= 10
        ));
    }

    function isValidEvaluation(data) {
      return data.keys().hasAll([
          'id', 'ownerId', 'status', 'patientName', 'hn', 'an', 'age', 'ward',
          'dateOfVisit', 'dateOfOperation', 'diagnosis', 'operation',
          'asaClass', 'asaEmergency', 'expectedDifficultAirway',
          'hasComplication', 'anesthesiaType', 'formData', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'status', 'patientName', 'hn', 'an', 'age', 'gender', 'ward', 'bed', 'specialty',
          'dateOfVisit', 'dateOfOperation', 'operationTime', 'scheduleType', 'orRoom', 'caseOrder',
          'surgeon', 'diagnosis', 'operation',
          'asaClass', 'asaEmergency', 'expectedDifficultAirway',
          'hasComplication', 'anesthesiaType', 'formData', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.ownerId)
        && (data.status in ['draft', 'evaluated', 'post_op_completed', 'locked'])
        && isNonEmptyStr(data.patientName, 120)
        && isStr(data.hn, 40)
        && isStr(data.an, 40)
        && isStr(data.age, 16)
        && (!('gender' in data) || (data.gender in ['', 'male', 'female']))
        && isStr(data.ward, 80)
        && (!('bed' in data) || isStr(data.bed, 32))
        && (!('specialty' in data) || isStr(data.specialty, 80))
        && isStr(data.dateOfVisit, 32)
        && isStr(data.dateOfOperation, 32)
        && (!('operationTime' in data) || isStr(data.operationTime, 32))
        && (!('scheduleType' in data) || (data.scheduleType in ['elective', 'emergency']))
        && (!('orRoom' in data) || isStr(data.orRoom, 32))
        && (!('caseOrder' in data) || isStr(data.caseOrder, 16))
        && (!('surgeon' in data) || isStr(data.surgeon, 120))
        && isStr(data.diagnosis, 300)
        && isStr(data.operation, 300)
        && (data.asaClass in ['', 'I', 'II', 'III', 'IV', 'V', 'VI'])
        && data.asaEmergency is bool
        && data.expectedDifficultAirway is bool
        && data.hasComplication is bool
        && (data.anesthesiaType in ['', 'GA', 'RA', 'GA+RA', 'MAC'])
        && isValidFormData(data.formData)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMedicationCatalog(data) {
      return data.keys().hasAll(['id', 'ownerId', 'groups', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'groups', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.ownerId)
        && data.groups is list
        && data.groups.size() <= 20
        && (
          data.groups.size() == 0 || (
            data.groups[0] is map
            && data.groups[0].keys().hasAll(['id', 'label', 'items'])
            && data.groups[0].keys().hasOnly(['id', 'label', 'items', 'autoUnderlying'])
            && isNonEmptyStr(data.groups[0].id, 64)
            && isNonEmptyStr(data.groups[0].label, 100)
            && isBoundedStringList(data.groups[0].items, 30, 120)
          )
        )
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWardCatalog(data) {
      return data.keys().hasAll(['id', 'ownerId', 'wards', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'wards', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.ownerId)
        && isBoundedStringList(data.wards, 40, 80)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSurgeonCatalog(data) {
      return data.keys().hasAll(['id', 'ownerId', 'surgeons', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'surgeons', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.ownerId)
        && isBoundedStringList(data.surgeons, 100, 120)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOxygenCatalog(data) {
      return data.keys().hasAll(['id', 'ownerId', 'presets', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'presets', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.ownerId)
        && isBoundedStringList(data.presets, 40, 120)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSummarizerCatalog(data) {
      return data.keys().hasAll(['id', 'ownerId', 'summarizers', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'summarizers', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.ownerId)
        && isBoundedStringList(data.summarizers, 100, 120)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidVisitorCatalog(data) {
      return data.keys().hasAll(['id', 'ownerId', 'visitors', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'visitors', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.ownerId)
        && isBoundedStringList(data.visitors, 100, 120)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSpecialtyCatalog(data) {
      return data.keys().hasAll(['id', 'ownerId', 'specialties', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'specialties', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.ownerId)
        && isBoundedStringList(data.specialties, 40, 80)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidEvaluationUpdate(next, prev) {
      return isValidEvaluation(next)
        && (prev.status != 'locked' || isAdmin())
        && next.id == prev.id
        && next.ownerId == prev.ownerId
        && next.createdAt == prev.createdAt
        && next.updatedAt == request.time
        && (
          // Action 1: Collaborative edit of evaluation content by any verified clinician
          next.diff(prev).affectedKeys().hasOnly([
            'status', 'patientName', 'hn', 'an', 'age', 'gender', 'ward', 'bed', 'specialty',
            'dateOfVisit', 'dateOfOperation', 'operationTime', 'scheduleType', 'orRoom', 'caseOrder',
            'surgeon', 'diagnosis', 'operation',
            'asaClass', 'asaEmergency', 'expectedDifficultAirway',
            'hasComplication', 'anesthesiaType', 'formData', 'updatedAt'
          ])
          ||
          // Action 2: Transition status only
          next.diff(prev).affectedKeys().hasOnly(['status', 'updatedAt'])
        );
    }

    // 3. Collection Match Block: /evaluations/{evaluationId}
    // Shared clinical team workspace: all verified clinicians can view, list, create,
    // and collaboratively update unlocked evaluations while preserving immutable creator provenance.
    match /evaluations/{evaluationId} {
      allow get: if isVerifiedUser()
        && isValidId(evaluationId)
        && existing().status in ['draft', 'evaluated', 'post_op_completed', 'locked'];

      allow list: if isVerifiedUser()
        && resource.data.status in ['draft', 'evaluated', 'post_op_completed', 'locked'];

      allow create: if isVerifiedUser()
        && isValidId(evaluationId)
        && isValidEvaluation(incoming())
        && incoming().id == evaluationId
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(evaluationId)
        && isValidEvaluationUpdate(incoming(), existing());

      allow delete: if isVerifiedUser()
        && isValidId(evaluationId)
        && (existing().ownerId == request.auth.uid || isAdmin());
    }

    // 4. Collection Match Block: /medicationCatalogs/{catalogId}
    match /medicationCatalogs/{catalogId} {
      allow get: if isVerifiedUser()
        && isValidId(catalogId)
        && catalogId == request.auth.uid
        && (resource == null || existing().ownerId == request.auth.uid);

      allow create: if isVerifiedUser()
        && isValidId(catalogId)
        && catalogId == request.auth.uid
        && isValidMedicationCatalog(incoming())
        && incoming().id == catalogId
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(catalogId)
        && catalogId == request.auth.uid
        && isValidMedicationCatalog(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['groups', 'updatedAt']);

      allow delete: if isVerifiedUser()
        && isValidId(catalogId)
        && catalogId == request.auth.uid
        && existing().ownerId == request.auth.uid;
    }

    // 5. Collection Match Block: /wardCatalogs/{catalogId}
    match /wardCatalogs/{catalogId} {
      allow get: if isVerifiedUser()
        && isValidId(catalogId)
        && catalogId == request.auth.uid
        && (resource == null || existing().ownerId == request.auth.uid);

      allow create: if isVerifiedUser()
        && isValidId(catalogId)
        && catalogId == request.auth.uid
        && isValidWardCatalog(incoming())
        && incoming().id == catalogId
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(catalogId)
        && catalogId == request.auth.uid
        && isValidWardCatalog(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['wards', 'updatedAt']);

      allow delete: if isVerifiedUser()
        && isValidId(catalogId)
        && catalogId == request.auth.uid
        && existing().ownerId == request.auth.uid;
    }

    // 6. Collection Match Block: /surgeonCatalogs/{catalogId}
    match /surgeonCatalogs/{catalogId} {
      allow get: if isVerifiedUser()
        && isValidId(catalogId)
        && catalogId == request.auth.uid
        && (resource == null || existing().ownerId == request.auth.uid);

      allow create: if isVerifiedUser()
        && isValidId(catalogId)
        && catalogId == request.auth.uid
        && isValidSurgeonCatalog(incoming())
        && incoming().id == catalogId
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(catalogId)
        && catalogId == request.auth.uid
        && isValidSurgeonCatalog(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['surgeons', 'updatedAt']);

      allow delete: if isVerifiedUser()
        && isValidId(catalogId)
        && catalogId == request.auth.uid
        && existing().ownerId == request.auth.uid;
    }

    // 7. Collection Match Block: /oxygenCatalogs/{catalogId}
    match /oxygenCatalogs/{catalogId} {
      allow get: if isVerifiedUser()
        && isValidId(catalogId)
        && catalogId == request.auth.uid
        && (resource == null || existing().ownerId == request.auth.uid);

      allow create: if isVerifiedUser()
        && isValidId(catalogId)
        && catalogId == request.auth.uid
        && isValidOxygenCatalog(incoming())
        && incoming().id == catalogId
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(catalogId)
        && catalogId == request.auth.uid
        && isValidOxygenCatalog(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['presets', 'updatedAt']);

      allow delete: if isVerifiedUser()
        && isValidId(catalogId)
        && catalogId == request.auth.uid
        && existing().ownerId == request.auth.uid;
    }

    // 8. Collection Match Block: /summarizerCatalogs/{catalogId}
    match /summarizerCatalogs/{catalogId} {
      allow get: if isVerifiedUser()
        && isValidId(catalogId)
        && catalogId == request.auth.uid
        && (resource == null || existing().ownerId == request.auth.uid);

      allow create: if isVerifiedUser()
        && isValidId(catalogId)
        && catalogId == request.auth.uid
        && isValidSummarizerCatalog(incoming())
        && incoming().id == catalogId
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(catalogId)
        && catalogId == request.auth.uid
        && isValidSummarizerCatalog(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['summarizers', 'updatedAt']);

      allow delete: if isVerifiedUser()
        && isValidId(catalogId)
        && catalogId == request.auth.uid
        && existing().ownerId == request.auth.uid;
    }

    // 9. Collection Match Block: /visitorCatalogs/{catalogId}
    match /visitorCatalogs/{catalogId} {
      allow get: if isVerifiedUser()
        && isValidId(catalogId)
        && catalogId == request.auth.uid
        && (resource == null || existing().ownerId == request.auth.uid);

      allow create: if isVerifiedUser()
        && isValidId(catalogId)
        && catalogId == request.auth.uid
        && isValidVisitorCatalog(incoming())
        && incoming().id == catalogId
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(catalogId)
        && catalogId == request.auth.uid
        && isValidVisitorCatalog(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['visitors', 'updatedAt']);

      allow delete: if isVerifiedUser()
        && isValidId(catalogId)
        && catalogId == request.auth.uid
        && existing().ownerId == request.auth.uid;
    }

    // 10. Collection Match Block: /specialtyCatalogs/{catalogId}
    match /specialtyCatalogs/{catalogId} {
      allow get: if isVerifiedUser()
        && isValidId(catalogId)
        && catalogId == request.auth.uid
        && (resource == null || existing().ownerId == request.auth.uid);

      allow create: if isVerifiedUser()
        && isValidId(catalogId)
        && catalogId == request.auth.uid
        && isValidSpecialtyCatalog(incoming())
        && incoming().id == catalogId
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(catalogId)
        && catalogId == request.auth.uid
        && isValidSpecialtyCatalog(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['specialties', 'updatedAt']);

      allow delete: if isVerifiedUser()
        && isValidId(catalogId)
        && catalogId == request.auth.uid
        && existing().ownerId == request.auth.uid;
    }
  }
}
